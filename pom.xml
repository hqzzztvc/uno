<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.legallynotuno</groupId>
    <artifactId>legallynotuno</artifactId>
    <version>1.1</version>
    <packaging>jar</packaging>

    <name>Legally Not Uno</name>
    <description>Legally Not Uno: a fully playable multiplayer card game for Paper 1.21.4 to 26.3</description>

    <properties>
        <!-- One jar for Paper 1.21.4 to 26.3. These two and api-version in plugin.yml are what
             set the oldest server it runs on; see "Paper version notes" in CLAUDE.md before
             raising any of them. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The OLDEST Paper API the plugin supports, on purpose, and not the newest. A jar
             compiled against 26.2+ links Adventure 5's TextComponent.Builder.build() and dies
             with NoSuchMethodError on every older server the first time a pot is shown; a jar
             compiled against 1.21.4 runs on all of them. Java 21 / class-file v65 for the same
             reason: Paper 1.21.x runs on Java 21.
             "provided" = supplied by the server at runtime, not bundled. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- The rules layer (Card/Deck/UnoGame) is pure Java with no Bukkit imports,
             so it is unit-testable without a server. See src/test/java. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Produces target/uno-<version>.jar. <version> above is the plugin's one version
             number: plugin.yml is filled in from it, and the update checker compares it with
             the version numbers published on Modrinth. -->
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <!-- Only plugin.yml is filtered. messages.yml is full of <tags> and config.yml
                 is the admin's to write; neither should ever have ${...} expanded in it. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
